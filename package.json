{
  "name": "wrapsheet",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "assets:raster": "node scripts/generate-raster-assets.mjs",
    "assets:pdf": "npm run build && node scripts/generate-sample-report.mjs",
    "assets": "npm run assets:raster && npm run assets:pdf",
    "verify:pages-artifact": "node scripts/verify-pages-artifact.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "verify": "npm test && npm run build && npm run test:e2e"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "astro": "^7.2.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@axe-core/playwright": "^4.10.2",
    "@playwright/test": "^1.55.0",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2"
  },
  "engines": {
    "node": ">=22"
  }
}
